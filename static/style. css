body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background: #f0f8ff;
    display: flex;
    justify-content: center;
}

.card {
    width: 95%;            /* Almost full width on mobile */
    max-width: 500px;      /* Limit width on larger screens */
    margin: 20px 0;
    padding: 20px;
    background: #ffffff;
    box-shadow: 0px 4px 12px rgba(0,0,0,0.1);
    border-radius: 12px;
}

h1 {
    color: #1e90ff;
    font-size: 2em;        /* Large title */
    margin-bottom: 15px;
}

form label {
    display: block;
    font-weight: bold;
    font-size: 1.2em;      /* Larger labels */
    margin: 12px 0 6px;
    text-align: left;
}

form select, form button {
    width: 100%;
    padding: 12px;
    font-size: 1.2em;      /* Larger options and buttons */
    margin-bottom: 12px;
    border-radius: 6px;
    border: 1px solid #ccc;
}

button {
    background: #1e90ff;
    color: white;
    border: none;
    cursor: pointer;
    transition: background 0.3s;
}

button:hover {
    background: #0077cc;
}

.result {
    margin-top: 15px;
    font-size: 1.3em;      /* Bigger result text */
    line-height: 1.5;
    text-align: left;
}
